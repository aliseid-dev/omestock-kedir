rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow querying and reading organizations (for company code lookup and multi-tenancy)
    match /clients/{clientId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Allow authenticated access to all subcollections (products, warehouses, stores, staff, sales, audit_logs)
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Allow authenticated users to manage their user profile
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

